<odoo>
    <record id="view_device_log_list" model="ir.ui.view">
        <field name="name">device.log.list</field>
        <field name="model">device.log</field>
        <field name="arch" type="xml">
            <list string="Device Logs">
                <field name="name"/>
                <field name="device_id"/>
                <field name="voltage"/>
                <field name="current"/>
                <field name="state" widget="badge" decoration-success="state == 'loaded'" decoration-danger="state == 'error'"/>
                <field name="created_at"/>
            </list>
        </field>
    </record>

    <record id="view_device_log_form" model="ir.ui.view">
        <field name="name">device.log.form</field>
        <field name="model">device.log</field>
        <field name="arch" type="xml">
            <form string="Device Log">
                <header>
                    <button name="action_fetch" type="object" string="Load from API" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,loaded,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_id"/>
                            <field name="created_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="voltage" readonly="1"/>
                            <field name="current" readonly="1"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_device_log_search" model="ir.ui.view">
        <field name="name">device.log.search</field>
        <field name="model">device.log</field>
        <field name="arch" type="xml">
            <search string="Device Logs">
                <field name="name"/>
                <field name="device_id"/>
                <filter name="filter_loaded" string="Loaded" domain="[('state', '=', 'loaded')]"/>
                <filter name="filter_error" string="Error" domain="[('state', '=', 'error')]"/>
            </search>
        </field>
    </record>

    <record id="action_device_log" model="ir.actions.act_window">
        <field name="name">Device Logs</field>
        <field name="res_model">device.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_device_log_search"/>
    </record>

    <menuitem id="menu_simple_device_root" name="Device Logger" sequence="10"/>
    <menuitem id="menu_device_log" name="Device Logs" parent="menu_simple_device_root" action="action_device_log" sequence="10"/>
</odoo>
